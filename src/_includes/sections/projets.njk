{#
  Projets sélectionnés : cartes groupées par deux, la seconde de chaque rangée décalée vers le bas.
  Alterner les formats (paysage/portrait puis portrait/paysage) donne la composition du design.
  Usage : {% from "sections/projets.njk" import projets %}
          {{ projets({ id, titre, lien: { texte, url }, projets: [{ titre, categorie, image, alt, format, url }] }) }}
#}
{% macro projets(s) %}
{% from "components/bouton-lien.njk" import boutonLien %}
{% from "components/carte-projet.njk" import carteProjet %}
<section class="projets"{% if s.id %} id="{{ s.id }}"{% endif %}>
  <div class="container">
    <div class="section-head">
      <h2 class="t-display-l">{{ s.titre }}</h2>
      {% if s.lien %}{{ boutonLien(s.lien.texte, s.lien.url) }}{% endif %}
    </div>
    {% for rangee in s.projets | batch(2) %}
    <div class="row row--{{ rangee[0].format or 'paysage' }}-{{ (rangee[1].format if rangee[1]) or 'portrait' }}">
      {{ carteProjet(rangee[0]) }}
      {% if rangee[1] %}<div class="offset">{{ carteProjet(rangee[1]) }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
</section>
{% endmacro %}

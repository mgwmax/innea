{#
  Intro de page : ouverture des pages internes, sous le header Toile.
  Label à gauche ; titre fin (deux lignes au plus) et texte optionnel à droite.
  Usage : {% from "sections/intro-de-page.njk" import introDePage %}
          {{ introDePage({ label, titre: [lignes…], texte }) }}
#}
{% macro introDePage(i) %}
<section class="intro">
  <div class="container">
    <p class="t-label taupe">{{ i.label }}</p>
    <div class="intro__texte">
      <h1 class="t-display-l">{{ i.titre | lignes | safe }}</h1>
      {% if i.texte %}<p class="t-texte">{{ i.texte }}</p>{% endif %}
    </div>
  </div>
</section>
{% endmacro %}

{#
  Équipe (page Studio) : deux portraits à gauche (le second décalé vers le bas), texte à droite.
  Usage : {% from "sections/equipe.njk" import equipe %}
          {{ equipe({ label, titre, texte, portraits: [{ image, alt }, { image, alt }] }) }}
#}
{% macro equipe(e) %}
<section class="equipe">
  <div class="container">
    <div class="equipe__portraits">
      {% for p in e.portraits %}<img src="{{ p.image }}" alt="{{ p.alt }}" loading="lazy">{% endfor %}
    </div>
    <div class="equipe__texte">
      <p class="t-label taupe">{{ e.label }}</p>
      <h2 class="t-titre-l">{{ e.titre }}</h2>
      {% if e.texte %}<p class="t-texte">{{ e.texte }}</p>{% endif %}
    </div>
  </div>
</section>
{% endmacro %}

{#
  Savoir-faire : titre et objets en trois colonnes.
  Usage : {% from "sections/savoir-faire.njk" import savoirFaire %}
          {{ savoirFaire({ titre, objets: [{ image, alt, titre, texte }] }) }}
#}
{% macro savoirFaire(s) %}
{% from "components/objet.njk" import objet %}
<section class="savoir"{% if s.id %} id="{{ s.id }}"{% endif %}>
  <div class="container">
    <h2 class="t-display-l">{{ s.titre }}</h2>
    <div class="cols-3">
      {% for o in s.objets %}{{ objet(o) }}{% endfor %}
    </div>
  </div>
</section>
{% endmacro %}

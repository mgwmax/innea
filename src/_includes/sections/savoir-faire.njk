{#
  Grille d'objets : titre (légende optionnelle à droite, ou texte d'intro dessous), objets en trois colonnes.
  Sert à « Ce que nous apportons » (accueil), « Notre regard. » et « Des idées posées sur le papier. » (studio).
  Usage : {% from "sections/savoir-faire.njk" import savoirFaire %}
          {{ savoirFaire({ id, titre, legende, texte, objets: [{ image, alt, titre, texte }] }) }}
          texte       → paragraphe d'intro sous le titre (colonne de 896px)
          carre: true → photos carrées (sinon 416×500)
          numerote: true → objets affichés en « Avantages » : photo carrée et surtitre numéroté (01 ——)
          espaceHaut: true → 160px au-dessus (après une photo pleine largeur) ; filet: true → filet pleine largeur en haut
#}
{% macro savoirFaire(s) %}
{% from "components/objet.njk" import objet %}
{% from "components/avantage.njk" import avantage %}
<section class="savoir{% if s.espaceHaut %} savoir--espace-haut{% endif %}{% if s.filet %} savoir--filet{% endif %}{% if s.carre %} savoir--carre{% endif %}"{% if s.id %} id="{{ s.id }}"{% endif %}>
  <div class="container">
    {% if s.legende %}
    <div class="section-head">
      <h2 class="t-display-l" data-reveal="titre">{{ s.titre }}</h2>
      <p class="t-legende taupe" data-reveal="texte">{{ s.legende }}</p>
    </div>
    {% elif s.texte %}
    <div class="savoir__intro">
      <h2 class="t-display-l" data-reveal="titre">{{ s.titre }}</h2>
      <p class="t-texte" data-reveal="texte">{{ s.texte }}</p>
    </div>
    {% else %}
    <h2 class="t-display-l" data-reveal="titre">{{ s.titre }}</h2>
    {% endif %}
    <div class="cols-3">
      {% for o in s.objets %}{{ avantage(loop.index, o) if s.numerote else objet(o) }}{% endfor %}
    </div>
  </div>
</section>
{% endmacro %}

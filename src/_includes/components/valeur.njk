{#
  Valeur (page Studio, « Notre approche ») : filet en haut, numéro optionnel, titre, texte.
  Usage : {% from "components/valeur.njk" import valeur %}
          {{ valeur(1, "La lumière", "Nous travaillons la lumière…") }}
          {{ valeur(false, "Échanger", "Chaque projet commence…") }}   → sans numéro
#}
{% macro valeur(numero, titre, texte) %}
<div class="valeur" data-reveal="texte">
  {% if numero %}<p class="t-label taupe">{{ numero | pad }}</p>{% endif %}
  <p class="t-titre-m">{{ titre }}</p>
  <p class="t-texte">{{ texte }}</p>
</div>
{% endmacro %}

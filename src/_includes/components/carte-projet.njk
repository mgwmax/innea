{#
  Carte projet : cliquable en entier, sans cadre ni ombre.
  Formats : "paysage" (816×560), "portrait" (464×600), "carre" (416×416). La photo est recadrée (object-fit: cover).
  Usage : {% from "components/carte-projet.njk" import carteProjet %}
          {{ carteProjet({ titre, categorie, image, alt, url, format }) }}
          {{ carteProjet(p, "carre") }}   → le 2e paramètre impose le format (sinon p.format, sinon paysage)
#}
{% macro carteProjet(p, format) %}
{% set f = format or p.format or "paysage" %}
<a href="{{ p.url or '#' }}" class="card card--{{ f }}" data-categorie="{{ p.categorie | slugify }}">
  <div class="card__frame"><img src="{{ p.image }}" alt="{{ p.alt }}" loading="lazy"></div>
  <div class="card__caption">
    <p class="t-titre-s">{{ p.titre }}</p>
    <p class="t-label taupe">{{ p.categorie }}</p>
  </div>
</a>
{% endmacro %}

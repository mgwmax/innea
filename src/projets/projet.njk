---
# Fiche projet : une page par projet de _data/realisations.json, publiée sur /projets/<slug>/
layout: layouts/base.njk
pagination:
  data: realisations.projets
  size: 1
  alias: projet
permalink: "/projets/{{ projet.slug }}/"
eleventyComputed:
  title: "{{ projet.titre }}"
  description: "{{ projet.titre }}{% if projet.lieu %}, {{ projet.lieu }}{% endif %}. Un projet INNEA."
---
{% from "sections/hero.njk" import hero as heroSection %}
{% from "sections/fiche-projet.njk" import ficheProjet %}
{% from "sections/galerie-projet.njk" import galerieProjet %}
{% from "sections/deux-projets.njk" import deuxProjets %}

{% set tous = realisations.projets %}
{% set n = tous | length %}
{% set index = pagination.pageNumber %}
{# « Autres projets » : les deux projets qui suivent dans la liste (on reprend au début après le dernier) #}
{% set autres = [tous[(index + 1) % n], tous[(index + 2) % n]] %}

{{ heroSection({
  titre: projet.titre,
  masque: "photo",
  diapositives: [{ image: projet.image, alt: projet.alt }],
  filAriane: [{ texte: "Projets", url: "/projets/" }, { texte: projet.titre }]
}) }}

{{ ficheProjet(projet) }}

{% if projet.galerie %}{{ galerieProjet(projet.galerie, projet.details) }}{% endif %}

{{ deuxProjets(autres, { titre: "Autres projets", lien: { texte: "Tous les projets", url: "/projets/" }, filet: true }) }}

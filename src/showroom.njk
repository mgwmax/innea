categories:
  art: { nom: Art de la table, image: /assets/photos/categorie-art-de-la-table.webp, alt: "Assiettes et bols en céramique" }
  bain: { nom: Bain, image: /assets/photos/categorie-bain.webp, alt: "Serviettes, savons et flacons" }
  bougies: { nom: Bougies & senteurs, image: /assets/photos/categorie-bougies.webp, alt: "Bougies parfumées et diffuseur" }
  livres: { nom: Livres, image: /assets/photos/categorie-livres.webp, alt: "Livres de décoration et bougie" }
  tapis: { nom: Tapis, image: /assets/photos/categorie-tapis.webp, alt: "Tapis tissés roulés" }
  textiles: { nom: Textiles, image: /assets/photos/categorie-textiles.webp, alt: "Plaids pliés sur une chaise en bois" }
  vases: { nom: Vases & bougeoirs, image: /assets/photos/categorie-vases.webp, alt: "Vase noir, bougeoirs en verre et branches" }

# Sélection : quatre variantes, toutes affichées en attendant le choix — supprimer celles qui ne sont pas retenues
selectionCommun: &commun
